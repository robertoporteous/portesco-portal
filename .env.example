# PORTESCO Portal — environment variables (AGENTS.md §4)
# Copy to .env.local and fill with real values. NEVER commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=https://app.portescosports.com

# --- AI (Sprint 2 Bloque 3) ---
# Caps $20/mes c/u. Toda call a estos SDKs pasa por lib/ai/{whisper,claude}.ts
# y escribe audit_logs (AGENTS.md §3.3). Nunca llamar al SDK directo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
